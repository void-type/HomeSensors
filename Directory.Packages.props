<Project>
  <!-- All package versions live here. dotnet outdated -u updates these entries. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
